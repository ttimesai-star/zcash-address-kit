{
  "name": "zcash-address-kit",
  "version": "0.1.0",
  "description": "Parse and validate every Zcash address type (Unified u1/zu/tu with F4Jumble, Sapling, TEX, transparent) in pure TypeScript. No keys, no WASM, no network, no runtime dependencies; ESM and CommonJS builds.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "zcash",
    "zec",
    "unified-address",
    "zip-316",
    "zip-320",
    "f4jumble",
    "sapling",
    "orchard",
    "address-validation",
    "bech32m"
  ],
  "author": "Artur Baranouski (ttimesai-star)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttimesai-star/zcash-address-kit.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
